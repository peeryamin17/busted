# ── BugSeek AI backend ─────────────────────────────────────────────
# Copy to `.env` and fill in. NEVER commit a real `.env` with secrets.

# Server
PORT=3000
NODE_ENV=development
# Browser origins allowed to call this API with credentials (session
# cookies). Comma-separated exact origins — in production the website's
# origin MUST be listed (e.g. https://bugseek-ai.vercel.app) or the
# browser will block sign-in. Never use "*": invalid with credentials,
# and the backend refuses to boot with it in production.
# Unset → localhost dev origins (Vite dev + preview). A legacy single
# CORS_ORIGIN value is still honoured when ALLOWED_ORIGINS is unset.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Auth — REQUIRED in production. In development a default is used with a warning.
JWT_SECRET=change-me-to-a-long-random-string

# LLM provider: "gemini" (default, Google AI), "claude" (Anthropic), or "mock"
# (deterministic stub: no network, no cost — used for tests and as fallback).
# If LLM_PROVIDER=gemini but GEMINI_API_KEY is unset, the backend falls back
# to the mock provider with a warning, so `npm run dev` needs zero setup.
LLM_PROVIDER=gemini
# Google AI (Gemini) API key — ONLY via this env var. Never hardcode, never commit.
GEMINI_API_KEY=
# Tiered model routing (cost control): Flash-class for high-volume routine
# calls (planning), Pro-class for complex reasoning (reflection, severity).
# NOTE (Oct 2026): gemini-2.5-* is deprecated for new users (API redirects to
# 3.x) — do not set 2.5-series models here. For ultra-cheap triage/dedup use
# gemini-3.5-flash-lite (verified fast, ~1s). If gemini-3.8-flash 503s under
# load, cascade to gemini-3.7-flash / gemini-3.6-flash (same price tier).
GEMINI_ROUTINE_MODEL=gemini-3.8-flash
GEMINI_REASONING_MODEL=gemini-3.1-pro-preview
# Anthropic fallback — ONLY via env var. Never hardcode, never commit.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Database — optional locally. When unset, an in-memory store is used (data is lost on restart).
# Production: Neon free tier → your project → Connection string (pooled URI).
# After setting DATABASE_URL, apply the schema once from this directory with:
#   npm run migrate
# It applies any pending backend/migrations/*.sql in order and is safe to
# re-run — already-applied files are skipped.
DATABASE_URL=

# Queue — optional. When unset, jobs run in-process (no Redis needed).
# For production use a managed Redis (e.g. Upstash) and set REDIS_URL.
REDIS_URL=

# Agent guardrails (legal guardrails are first-class features — see README)
AGENT_MAX_ACTIONS=40
AGENT_MAX_DURATION_MIN=15
AGENT_REQUESTS_PER_SECOND=2
# Allow scanning RFC1918/localhost targets (needed for local test apps like
# OWASP Juice Shop / DVWA). MUST stay false in production.
ALLOW_PRIVATE_TARGETS=false

# API rate limiting (requests per minute per client IP)
API_RATE_LIMIT_PER_MIN=120

# Google sign-in ("Sign in with Google" on the website, handled by our
# backend — no third-party auth service). All three values are required
# for sign-in; when unset the app still boots and the sign-in routes
# answer 503. The secret is server-side only: never put it in frontend
# code, never commit a real one.
# Google Cloud Console → APIs & Services → Credentials → OAuth client:
#   Authorised redirect URI must exactly match GOOGLE_REDIRECT_URI
#   (e.g. http://localhost:3000/api/auth/google/callback in development).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Where the browser lands after a successful sign-in. In production set
# the full website URL, e.g. https://bugseek-ai.vercel.app/app
POST_LOGIN_REDIRECT=/app
# Signs the OAuth state cookie. REQUIRED in production; long random string.
SESSION_SECRET=change-me-to-a-long-random-string

# Operator account email — the only account allowed to call GET /api/admin/users.
ADMIN_EMAIL=
