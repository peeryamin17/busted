{
  "note": "Detection patterns only. No key material from the archive is stored here — MachineKeys.txt values were measured for length classes and then discarded.",
  "machineKey": {
    "source": "API Key Leaks/IIS-Machine-Keys.md",
    "configFiles": [
      "web.config",
      "machine.config"
    ],
    "attributePatterns": [
      {
        "id": "machinekey-validationkey",
        "pattern": "validationKey\\s*=\\s*\"[0-9A-Fa-f]{40,128}\"",
        "description": "ASP.NET validationKey attribute holding a hex key"
      },
      {
        "id": "machinekey-decryptionkey",
        "pattern": "decryptionKey\\s*=\\s*\"[0-9A-Fa-f]{48,64}\"",
        "description": "ASP.NET decryptionKey attribute holding a hex key"
      },
      {
        "id": "machinekey-element",
        "pattern": "<machineKey[^>]*validationKey\\s*=\\s*\"[^\"]+\"[^>]*decryptionKey\\s*=\\s*\"[^\"]+\"",
        "description": "A machineKey element carrying both keys"
      }
    ],
    "observedHexLengths": {
      "validationKey": {
        "commonLengths": [
          40,
          64,
          128
        ],
        "outlierRows": 33
      },
      "decryptionKey": {
        "commonLengths": [
          48,
          64
        ],
        "outlierRows": 20
      },
      "rowsMeasured": 3571,
      "source": "API Key Leaks/Files/MachineKeys.txt"
    }
  },
  "hardcodedAssignment": {
    "source": "API Key Leaks/README.md",
    "note": "Generic shapes for the hardcoded-key cause described in the methodology section.",
    "patterns": [
      {
        "id": "hardcoded-api-key",
        "pattern": "\\b(api[_-]?key|apikey)\\s*[:=]\\s*['\"][^'\"]{8,}['\"]",
        "flags": "i",
        "description": "An API key assigned inline in source"
      },
      {
        "id": "hardcoded-secret",
        "pattern": "\\b(client[_-]?secret|secret[_-]?key)\\s*[:=]\\s*['\"][^'\"]{8,}['\"]",
        "flags": "i",
        "description": "A client secret assigned inline in source"
      }
    ]
  }
}
